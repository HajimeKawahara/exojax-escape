# Independent external-model comparison; atomic rates are not identical.
title Pure hydrogen thin reference nmax=5
blackbody 10000 K dilution 0.025
hden 8
constant temperature 14000 K linear
init file "honly.ini"
no molecules
database H-like levels resolved 3 element hydrogen
database H-like levels collapsed 2 element hydrogen
database H-like topoff off
database H-like levels print
set dr -4
stop zone 1
iterate to convergence
print h-like population hydrogen
save hydrogen populations "rates_T14000_n8.populations" last
save hydrogen conditions "rates_T14000_n8.conditions" last
save hydrogen ionization "rates_T14000_n8.ionization" last
save line optical depths "rates_T14000_n8.line_tau" last
save species densities "rates_T14000_n8.levels" "H[:]" last
normalize to "H  1" 6562.80A
save hydrogen lines "rates_T14000_n8.hydrogen_lines" last
set eden convergence 0.000001
set continuum resolution 0.05
