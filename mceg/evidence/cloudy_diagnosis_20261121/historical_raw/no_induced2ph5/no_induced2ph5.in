# Independent external-model comparison; atomic rates are not identical.
title Pure hydrogen thin reference nmax=5
blackbody 10000 K dilution 0.025
hden 12
constant temperature 9000 K linear
init file "honly.ini"
no molecules
database H-like levels resolved 3 element hydrogen
database H-like levels collapsed 2 element hydrogen
database H-like topoff off
database H-like levels print
set dr -4
stop zone 1
iterate to convergence
print h-like population hydrogen
save hydrogen populations "no_induced2ph5.populations" last
save hydrogen conditions "no_induced2ph5.conditions" last
save hydrogen ionization "no_induced2ph5.ionization" last
save line optical depths "no_induced2ph5.line_tau" last
save optical depths "no_induced2ph5.continuum_tau" last
save continuum "no_induced2ph5.continuum" last units eV
save species densities "no_induced2ph5.levels" "H[:]" last
normalize to "H  1" 6562.80A
save hydrogen lines "no_induced2ph5.hydrogen_lines" last
set eden convergence 0.000001
set continuum resolution 0.05
set induced two photon off
