# Independent external-model comparison; atomic rates are not identical.
title Pure hydrogen thin reference nmax=5
blackbody 10000 K dilution 0.025
hden 12
constant temperature 9000 K linear
init file "honly.ini"
no molecules
database H-like levels resolved 3 element hydrogen
database H-like levels collapsed 2 element hydrogen
database H-like topoff off
database H-like levels print
set dr -4
stop zone 1
iterate to convergence
print h-like population hydrogen
save hydrogen populations "thin_nmax5_fine.populations" last
save hydrogen conditions "thin_nmax5_fine.conditions" last
save hydrogen ionization "thin_nmax5_fine.ionization" last
save line optical depths "thin_nmax5_fine.line_tau" last
save optical depths "thin_nmax5_fine.continuum_tau" last
save continuum "thin_nmax5_fine.continuum" last units eV
save species densities "thin_nmax5_fine.levels" "H[:]" last
normalize to "H  1" 6562.80A
save hydrogen lines "thin_nmax5_fine.hydrogen_lines" last
set eden convergence 0.000001
set continuum resolution 0.2
